# 中转站 Plus 服务端配置（复制为 .env 并按需修改）
PORT=8080
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgres://relay:relay_pass@localhost:5432/relay_plus

# JWT 密钥（生产环境务必改为随机长字符串，>=24 位）
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# 管理后台初始管理员（首次启动 seed 时创建）
ADMIN_EMAIL=admin@relay.local
ADMIN_PASSWORD=admin123456

# 运营模式（RUN_MODE=simple 隐藏 SaaS 计费界面；full=完整模式）
RUN_MODE=full

# 站点信息
SITE_NAME=中转站 Plus
# 对外公网地址（用于生成分享/回调链接等；留空则自动取请求 Host）
PUBLIC_BASE_URL=

# 是否开放用户注册
ALLOW_REGISTER=true

# 新用户默认余额（美元，纯充值制填 0）
DEFAULT_BALANCE=0

# 免费体验额度：>0 时新用户可领一次（美元）
FREE_GRANT_AMOUNT=0

# CORS 白名单（逗号分隔；留空=允许所有来源，生产建议填写前端域名）
CORS_ORIGINS=

# 登录安全
LOGIN_MAX_FAILS=5          # 连续失败次数
LOGIN_LOCK_SECONDS=600     # 锁定秒数
LOGIN_IP_WINDOW_SEC=60     # IP 限流窗口
LOGIN_IP_BURST=20          # 窗口内最大请求数

# 注册限制
REGISTER_IP_CAP=5                        # 同一 IP 最大注册数（0=不限）
REGISTER_EMAIL_SUFFIX_WHITELIST=          # 允许注册的邮箱后缀白名单（逗号分隔，留空=不限）
REGISTER_EMAIL_DOMAIN_QUOTA=0             # 同一邮箱域最大注册数（0=不限）

# 计费与安全开关
BALANCE_LOW_THRESHOLD=0       # 余额低于此值时前端提示充值
USD_TO_CNY=7.2                # 充值展示汇率
ALLOW_UNPRICED=false          # 允许无价格模型放行（生产建议 false）
ALLOW_LOOPBACK_UPSTREAM=false # 允许上游指向本机/内网（仅本地开发用；生产必须 false）
ALLOW_GLOBAL_ROUTING=false    # 允许未绑分组账号被全局路由（生产建议 false）
TURNSTILE_SECRET=             # Cloudflare Turnstile 密钥（留空=不启用验证码）

# 可选：GitHub 登录 / 邮件（留空即不启用）
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=
SMTP_HOST=

# 网关默认上游超时（毫秒）
UPSTREAM_TIMEOUT_MS=300000

# OpenAI OAuth（与 Sub2API/Codex CLI 兼容的公共客户端，一般无需修改）
OPENAI_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
OPENAI_OAUTH_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
OPENAI_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
